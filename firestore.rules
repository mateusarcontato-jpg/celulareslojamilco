rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regra de segurança padrão
    match /{document=**} {
      allow read, write: if false;
    }

    // Coleção de teste de conectividade exigida pelas diretrizes do Firebase
    match /test/{testId} {
      allow read, write: if true;
    }

    // Coleção de perfis de técnicos e usuários autenticados
    match /users/{userId} {
      allow read, write: if true;
    }

    // Coleção principal de celulares e patrimônio corporativo Amilco
    match /devices/{deviceId} {
      allow read, write: if true;
    }

    // Configurações de Lojas, Setores e Metadados
    match /metadata/{metaId} {
      allow read, write: if true;
    }
  }
}
